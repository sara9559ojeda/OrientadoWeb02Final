# Configuración de MongoDB
# Opción 1: URI completa (recomendado)
MONGODB_URI=mongodb://admin:admin123@localhost:27017/multimedia_db?authSource=admin

# Opción 2: Variables individuales (si prefieres no usar MONGODB_URI)
# DATABASE_URL=mongodb://localhost:27017
# DATABASE_NAME=multimedia_db
# DATABASE_USERNAME=admin
# DATABASE_PASSWORD=admin123

# Configuración del servidor
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=tu_secreto_jwt_super_seguro_cambiar_en_produccion
JWT_EXPIRES_IN=24h

# CORS: orígenes del frontend permitidos, separados por comas.
# En producción: el dominio de Vercel, p. ej. https://mi-juego.vercel.app
# CORS_ORIGINS=http://localhost:5173,https://mi-juego.vercel.app
