# ---------------------------------------------------------------------------
# Desarrollo local. Copia este archivo a .env (que NO se sube a git).
# En producción (Render) estas variables se definen en el panel / render.yaml.
# ---------------------------------------------------------------------------

# Configuración de MongoDB
# Local (docker compose del backend):
MONGODB_URI=mongodb://admin:admin123@localhost:27017/multimedia_db?authSource=admin
# Producción (MongoDB Atlas): mongodb+srv://USUARIO:CLAVE@cluster.xxxxx.mongodb.net/multimedia_db?retryWrites=true&w=majority
# Obligatoria con NODE_ENV=production.

# Opción alternativa: variables individuales (si prefieres no usar MONGODB_URI)
# DATABASE_URL=mongodb://localhost:27017
# DATABASE_NAME=multimedia_db
# DATABASE_USERNAME=admin
# DATABASE_PASSWORD=admin123

# Configuración del servidor
# development | production. Con "production" el arranque FALLA si falta MONGODB_URI
# o si JWT_SECRET falta / es de ejemplo / tiene menos de 16 caracteres.
NODE_ENV=development
# Render asigna PORT automáticamente; el servidor escucha en 0.0.0.0:$PORT
PORT=3000

# JWT
# Genera uno aleatorio, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Este valor de ejemplo se RECHAZA en producción. En Render lo genera render.yaml (generateValue).
JWT_SECRET=tu_secreto_jwt_super_seguro_cambiar_en_produccion
JWT_EXPIRES_IN=24h

# CORS: orígenes del frontend permitidos, separados por comas (sin barra final).
# En producción: el dominio de Vercel, p. ej. https://mi-juego.vercel.app
# CORS_ORIGINS=http://localhost:5173,https://mi-juego.vercel.app
